# Copia este fichero a .env y ajusta lo que necesites.

# --- Modelo ---------------------------------------------------------------
# anthropic = modelo real (requiere clave) | fake = determinista, sin red
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Servicio -------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=json
# Si se define, POST/GET/DELETE /chat exigen la cabecera X-API-Key
API_KEY=

# --- Memoria --------------------------------------------------------------
# memory = en proceso (se pierde al reiniciar) | sqlite = persistente.
# La imagen de Docker ya trae sqlite sobre /data (el volumen de compose) y en
# local el valor por defecto es memory. Descomenta sólo si quieres cambiarlo.
# STORE_BACKEND=sqlite
# SQLITE_PATH=/data/conversations.db
MAX_STORED_MESSAGES=400

# --- Agente ---------------------------------------------------------------
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_S=90
TOOL_TIMEOUT_S=15
HISTORY_WINDOW=40
