# Copiar a .env y completar. .env está en .gitignore: no se commitea.

# --- Obligatorio ---
# Clave de la API de Anthropic (https://console.anthropic.com -> API Keys).
ANTHROPIC_API_KEY=

# --- Opcionales (estos son los valores por defecto) ---
# MODEL=claude-opus-5
# MAX_TOKENS=4096
# MAX_ITERATIONS=6
# HISTORY_MAX_TOKENS=12000
# LLM_TIMEOUT_SECONDS=60
# TOOL_TIMEOUT_SECONDS=20

# ENVIRONMENT=local
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# DATABASE_URL=sqlite:///./data/conversations.db

# Escape hatch para redes corporativas: yfinance usa curl_cffi para imitar el
# TLS de un navegador, y un proxy que reinspecciona TLS lo rechaza. Con esto
# cae al backend de `requests`, que sí respeta HTTPS_PROXY y REQUESTS_CA_BUNDLE.
# YF_DISABLE_CURL_CFFI=1
